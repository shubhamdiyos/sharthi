<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- System Design §2.1 / D11: Spring Boot 4.1.x on Java 21 (founder decision,
         v0.2.1). Boot 4's baseline is Java 17, so 21 is inside support. -->
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.saathi</groupId>
  <artifactId>saathi-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>Saathi API</name>
  <description>Modular monolith for the Saathi local delivery platform (PRD §11)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <archunit.version>1.5.1</archunit.version>
    <!-- Not in Boot's dependency management; see the spring-security-crypto comment below. -->
    <bouncycastle.version>1.82</bouncycastle.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Schema belongs to Flyway, never to Hibernate (§2.2, §4.2). JPA is on the
         classpath for the modules that need entities, not for the foundation. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Boot 4 split auto-configuration into per-technology modules. Without this one
         spring.flyway.* is inert, migrations never run at boot, and the readiness group
         has no 'flyway' member — so Compose's api healthcheck would never go green. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- §12.2 hashes passwords with Argon2id. Only the crypto module of Spring Security is
         needed, not its filter chain: sessions are the user_session row, not a SecurityContext.
         Argon2PasswordEncoder delegates the KDF to Bouncy Castle, which is not an optional
         transitive dependency — Argon2EncodingUtils references
         org.bouncycastle.crypto.params.Argon2Parameters directly, so a missing BC jar is a
         NoClassDefFoundError on the first staff login. Boot 4.1.2 manages spring-security-crypto
         but not bcprov, so the version is pinned in the properties block above. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- api.Dockerfile copies target/saathi-api.jar -->
    <finalName>saathi-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Explicit processor path: JDK 23+ disabled implicit annotation processing, and
               a build that only works because javac happened to find Lombok on the classpath
               is a build that breaks on the next JDK bump. -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Unit + architecture tests: no daemon, no database, no network.
               `mvn test` must be runnable on a laptop with nothing installed. -->
          <excludedGroups>integration</excludedGroups>
          <!-- A suite that silently matches nothing is a green build over no code. -->
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <groups>integration</groups>
          <!-- Failsafe prints "No tests to run" and exits 0. Against a foundation whose whole
               promise is that the schema and the wire contract were verified, that is a lie,
               so an empty integration suite fails the build on purpose. -->
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
