# Saathi — local environment template
#
#   cp .env.example .env
#   docker compose up -d --build
#
# `.env` is git-ignored and must never be committed. This file is the only
# committed list of configuration keys, and every value below is a placeholder
# that works on a laptop and would be worthless in production.
#
# Keys written as ${KEY:?...} in infra/docker/docker-compose.yml are REQUIRED:
# Compose refuses to start without them, on purpose. A missing secret fails the
# boot instead of silently shipping an app with a known default key.
#
# Generate real local secrets with:
#   openssl rand -base64 32


# ─── Application ──────────────────────────────────────────────────────────────
# dev | staging | prod. Drives the Spring profile and the fixture guards.
SAATHI_ENVIRONMENT=dev
SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Kolkata


# ─── PostgreSQL (container: postgres, port on the host: 5432) ─────────────────
POSTGRES_DB=saathi
POSTGRES_USER=saathi
# REQUIRED. Change it; anything non-default is fine locally.
POSTGRES_PASSWORD=local-only-change-me
# Host port published for client tools (TablePlus/psql/DBeaver). Inside the
# network the API always connects to postgres:5432, never to this value.
POSTGRES_PORT=5432


# ─── API (container: api, port on the host: 8080) ─────────────────────────────
API_PORT=8080

# REQUIRED — session signing/encryption secret (identity module, design §12.4).
# The application refuses to start without it.
SAATHI_SESSION_SECRET=dev-only-00000000000000000000000000-replace-me

# REQUIRED — daily-rotating HMAC key for audit_event.ip_hash (design §13).
# IP addresses are never stored in the clear.
SAATHI_AUDIT_IP_KEY=dev-only-00000000000000000000000000-replace-me

# OTP delivery. `logging` prints the code to the api container's logs, which is
# the documented dev-mode pilot for open decision OD-8; no provider is selected
# and no provider credential belongs in this file.
SAATHI_OTP_PROVIDER=logging


# ─── Object storage (container: minio — optional, profile "storage") ─────────
# Enable with:  docker compose --profile storage up -d
# Media upload is not built yet, so the service is off by default.
MINIO_ROOT_USER=saathi-local
MINIO_ROOT_PASSWORD=local-only-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SAATHI_S3_ENDPOINT=http://minio:9000
SAATHI_S3_BUCKET=saathi-media
SAATHI_S3_ACCESS_KEY=saathi-local
SAATHI_S3_SECRET_KEY=local-only-change-me
SAATHI_S3_REGION=us-east-1


# ─── Web (container: web, port on the host: 3000) ─────────────────────────────
WEB_PORT=3000

# Browser-visible by construction: anything prefixed NEXT_PUBLIC_ is compiled
# into the client bundle. Put no secret, token or internal hostname here — the
# PII disclosure rules (design §11.4) apply to the browser regardless of
# transport. This is the only NEXT_PUBLIC_ key the project is allowed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-side only (RSC/route handlers). Not sent to the browser.
API_BASE_URL=http://api:8080
